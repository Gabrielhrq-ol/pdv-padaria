# Copie este arquivo para .env e preencha com valores reais.
# .env NUNCA deve ser commitado.
#
# Gere o SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=change-me-generate-with-python-secrets

# Caminho do banco (relativo à raiz do projeto)
DB_PATH=./data/pdv.db

# development | production
ENVIRONMENT=development

# Host e porta do servidor (nunca mude de 127.0.0.1 sem motivo)
HOST=127.0.0.1
PORT=8000
